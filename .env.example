# Loom Framework Environment Configuration
# Copy this file to .env and update values for your deployment

# ============================================
# Database Configuration
# ============================================
DB_USER=loom_user
DB_PASSWORD=your_secure_password_here
DB_NAME=loom_db

# Full database URL (overrides individual settings if set)
# LOOM_DATABASE_URL=postgresql://loom_user:password@localhost:5432/loom_db

# ============================================
# Security Configuration
# ============================================
# CRITICAL: Generate a secure random secret for production
# Generate with: openssl rand -hex 32
LOOM_JWT_SECRET=your_64_character_hex_secret_here

# Token expiry times (in minutes/days)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# Execution Mode
# ============================================
# "personal" - Development mode with debug features
# "organization" - Production mode with strict security
LOOM_WORKSPACE_TYPE=organization

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
# Example: LOOM_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
LOOM_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# Feature Flags
# ============================================
LOOM_ENABLE_AUDIT=true
LOOM_ENABLE_COMMENTS=true

# ============================================
# Blueprint & Plugin Paths
# ============================================
# LOOM_BLUEPRINT_PATHS=blueprints,blueprints_project
# LOOM_PLUGIN_PATHS=plugins

# ============================================
# Logging
# ============================================
# LOG_LEVEL=INFO
# LOG_FORMAT=json  # or 'human' for development

# ============================================
# Rate Limiting
# ============================================
# RATE_LIMIT_REQUESTS_PER_MINUTE=60
